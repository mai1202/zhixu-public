# 生产环境密钥必须在服务器单独生成，不要提交真实值。
APP_ENV=production
AUTH_HMAC_KEY=请替换为至少32字节的随机字符串
LLM_ENCRYPTION_KEY=请替换为Fernet密钥
SESSION_COOKIE_SECURE=true
TRUSTED_ORIGINS=https://your-domain.example
# 登录白名单；留空或 * 关闭限制。未设置时不额外限制邮箱名单。
AUTH_ALLOWED_EMAILS=
# 平台模型按账户每日输入加输出限额，自配密钥不计入；公开副本没有预设豁免账户。
# 兼容旧环境键；平台额度现为北京时间每日3元，此 token 值不再限制调用。
PLATFORM_DAILY_TOKEN_LIMIT=2000000
# 普通与复杂任务统一上限，未完成的已授权任务可以在同一会话自主续轮。
AGENT_TOOL_BUDGET=1000
AGENT_COMPLEX_TOOL_BUDGET=1000
# 只填写实际 Docker 网桥网关；Nginx 经宿主机回环端口访问时使用该源地址。
WAITRESS_TRUSTED_PROXY=

# 每个邮箱的三个固定窗口同时生效；一分钟重发冷却内重复点击不扣额度。
AUTH_RATE_EMAIL_5MIN=3
AUTH_RATE_EMAIL_HOURLY=20
AUTH_RATE_EMAIL_DAILY=50
AUTH_RATE_IP_HOURLY=100

# 服务端默认模型：所有登录账户无需另填密钥即可使用；留空关闭。
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-flash
DEFAULT_LLM_API_KEY=

# 测试邮箱：请填邮箱服务商提供的 SMTP/IMAP 主机和客户端授权码。
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.163.com
SMTP_PORT=994
SMTP_AUTH_USER=
SMTP_AUTH_SECRET=
SMTP_FROM=
SMTP_STARTTLS=false
SMTP_USE_SSL=true

# 163 测试邮箱只读收信，不设置已读或删除原邮件。
INBOUND_MAIL_ENABLED=true
INBOUND_IMAP_HOST=imap.163.com
INBOUND_IMAP_PORT=993
INBOUND_IMAP_USER=
INBOUND_IMAP_SECRET=
INBOUND_IMAP_FOLDER=INBOX
# 客户端下载包：可放在数据卷 /app/data/downloads/notification-collector-windows.zip，
# 或将 CLIENT_DOWNLOAD_URL 指向外部 HTTPS 下载地址。
# CLIENT_DOWNLOAD_URL=

# 评审版业务功能：独立审查和隐私告知默认启用，不需要订阅收款配置。
AGENT_TOOL_REVIEW_ENABLED=true
PRIVACY_CONSENT_REQUIRED=true
PRIVACY_CONTACT=
# 文件处理需另行准备隔离执行环境；当前 Compose 不开放 Docker socket。
FILE_SANDBOX_ENABLED=false
FILE_SANDBOX_IMAGE=python:3.13-alpine
TEST_PASSWORD_LOGIN_ENABLED=false
OPERATIONS_ALERT_EMAIL=
OPERATIONS_TEST_EMAIL=
