{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notification-management.local/contracts/ocr-result-v1.schema.json",
  "title": "OcrResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["engine_version", "model_id", "execution_location", "image_hash", "width", "height", "orientation", "elapsed_ms", "items", "warnings"],
  "properties": {
    "engine_version": { "type": "string", "maxLength": 100 },
    "model_id": { "type": "string", "maxLength": 200 },
    "execution_location": { "type": "string", "enum": ["browser", "server"] },
    "image_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "width": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "height": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "orientation": { "type": "integer", "enum": [0, 90, 180, 270] },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "poly", "score"],
        "properties": {
          "id": { "type": "string", "maxLength": 100 },
          "text": { "type": "string", "maxLength": 10000 },
          "poly": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" }
            }
          },
          "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string", "maxLength": 1000 }, "maxItems": 100 }
  }
}
