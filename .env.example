# 复制这些变量到服务管理器；应用不会自动读取 .env 文件。
APP_ENV=production
# 数据目录与 SQLite 位置。不设置时使用仓库内 data/（已列入 .gitignore）。
# 相对路径按进程工作目录解析：scripts/* 会先切换到 backend/，生产部署请写绝对路径。
# DATA_DIR=D:/notification-management-data
# DATABASE_URL=sqlite:///D:/notification-management-data/notification_management.sqlite3

# 使用以下命令分别生成至少 32 字节的随机密钥，再通过安全环境变量注入。
AUTH_HMAC_KEY=
LLM_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=true
TRUSTED_ORIGINS=https://notification.example.edu.cn

# 登录邮箱白名单（逗号分隔，大小写不敏感）。未设置时不额外限制邮箱名单；
# 留空或 * 表示关闭名单限制，仅建议开发/测试环境使用。
# AUTH_ALLOWED_EMAILS=teacher@example.edu.cn,student-a@example.edu.cn,student-b@example.edu.cn
# 平台模型每日输入加输出额度，自配密钥不计入；公开副本没有预设豁免账户。
# 兼容旧环境键；平台额度现为北京时间每日3元，此 token 值不再限制调用。
PLATFORM_DAILY_TOKEN_LIMIT=2000000

# 登录验证码、会话与限流（以下为默认值，可按部署需要调整）。
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
SESSION_COOKIE_TTL_SECONDS=28800
# 同一邮箱：5 分钟 3 次、1 小时 20 次、24 小时 50 次；三个窗口共同约束。
AUTH_RATE_EMAIL_5MIN=3
AUTH_RATE_EMAIL_HOURLY=20
AUTH_RATE_EMAIL_DAILY=50
AUTH_RATE_IP_HOURLY=100
AUTH_RATE_GLOBAL_HOURLY=100

# SMTP 默认关闭。学校运营邮箱主机、端口和发件地址必须由管理员核实后配置。
MAIL_TRANSPORT=disabled
# 首次打开引导后未完成配置的提醒等待时长；每个账户最多一次，可在引导页关闭。
# 发信通道关闭时不排队，不会因历史账户从未打开引导而批量提醒。
ONBOARDING_REMINDER_DELAY_SECONDS=86400
SMTP_HOST=
SMTP_PORT=587
SMTP_AUTH_USER=
SMTP_AUTH_SECRET=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# 运营邮箱收信（可选）。SMTP 发信可用不代表 IMAP 收信可用，需单独配置和验证。
INBOUND_MAIL_ENABLED=false
INBOUND_IMAP_HOST=
INBOUND_IMAP_PORT=993
INBOUND_IMAP_USER=
INBOUND_IMAP_SECRET=
INBOUND_IMAP_FOLDER=INBOX

# 联网检索：DuckDuckGo 免密钥默认入口；Brave 配置密钥后参与回退或多源核对。
DUCKDUCKGO_ENABLED=true
DUCKDUCKGO_REGION=cn-zh
DUCKDUCKGO_TIMEOUT_SECONDS=8
WEB_SEARCH_API_KEY=
SEARCH_CACHE_SECONDS=120
SEARCH_PROVIDER_FAILURE_THRESHOLD=3
SEARCH_PROVIDER_COOLDOWN_SECONDS=120

# 可选向量检索。未启用或端点不安全时自动使用关键词检索。
# 云端 embedding 必须显式允许，且只发送用于建索引的文本。
EMBEDDING_ENABLED=false
EMBEDDING_ENDPOINT=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=0
EMBEDDING_TIMEOUT_SECONDS=20
EMBEDDING_ALLOW_CLOUD=false
RETRIEVAL_CHUNK_CHARS=600
RETRIEVAL_CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=8

# Microsoft Graph 使用 delegated Mail.Send；refresh token 通过 CLI 加密存入数据库。
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=consumers
GRAPH_REFRESH_TOKEN=
GRAPH_TIMEOUT_SECONDS=20

# 模型接入。自定义 OpenAI 兼容服务必须显式加入主机允许列表（逗号分隔）。
LLM_ALLOWED_CUSTOM_HOSTS=

# 服务端默认模型：配置后所有登录账户自动获得可用的提取与规划配置，无需另填密钥。
# 留空 DEFAULT_LLM_API_KEY 即关闭该功能。密钥只保存在服务器环境变量和加密数据库中。
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-flash
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_TIMEOUT_SECONDS=60

# Windows 采集客户端下载包。可放在数据目录 downloads/ 下，或直接配置外部下载地址。
# CLIENT_DOWNLOAD_DIR=
# CLIENT_DOWNLOAD_FILENAME=notification-collector-windows.zip
# CLIENT_DOWNLOAD_URL=

# 服务端 OCR（可选）。未设置 OCR_CHROMIUM_EXECUTABLE 时使用 Playwright 安装的 Chromium。
# OCR_CHROMIUM_EXECUTABLE=D:/browsers/chrome.exe
OCR_RUNNER_TIMEOUT_SECONDS=180

# 服务仅监听本机回环地址，外部访问应由 TLS 反向代理接入。
SERVER_LISTEN=127.0.0.1:8080
SERVER_THREADS=8
WAITRESS_TRUSTED_PROXY=

# 独立 worker 的任务租约（可选）。
WORKER_LEASE_SECONDS=600

# Pi 智能助手服务。Flask 只通过回环地址调用它；浏览器不能直接访问。
PI_AGENT_URL=http://127.0.0.1:5011
PI_RUN_TIMEOUT_SECONDS=540
# 每轮业务工具上限；助手可用 continue_agent_run 沿用会话自主续轮，额度与取消仍然生效。
AGENT_TOOL_BUDGET=1000
AGENT_COMPLEX_TOOL_BUDGET=1000
# 仅 scripts/run-agent.* 的 Node 进程使用；维护脚本从 AUTH_HMAC_KEY 派生，不要手写或提交。
# PI_BRIDGE_TOKEN=
PI_CALLBACK_URL=http://127.0.0.1:8080
PI_AGENT_PORT=5011
# 新要求链可分阶段发布；自动排程还需要用户全局与逐项明确授权。
# 完成目标数据库迁移与并发验收后才能开启；默认仅试算和手动应用。
PLANNING_AUTOMATIC_VERIFIED=false

# 计划书评审版：写入前独立模型审查、登录隐私告知默认开启。
AGENT_TOOL_REVIEW_ENABLED=true
PRIVACY_CONSENT_REQUIRED=true
# 显示给用户的真实项目联系人；未设置时提示联系内测邀请人。
PRIVACY_CONTACT=

# 可选的授权文件处理。需在实际执行进程所在环境安装 Docker CLI/运行时并预拉取镜像。
# 生产 Compose 未给 API/worker Docker 权限，因此仅打开此开关不会获得容器能力。
FILE_SANDBOX_ENABLED=false
FILE_SANDBOX_IMAGE=python:3.13-alpine

# 管理端预置的领导测试账号可启用密码登录；密码摘要和独立日预算保存在数据库。
TEST_PASSWORD_LOGIN_ENABLED=false
# DeepSeek平台余额不足时邮件告警，附带下列测试账号最近七天账本；默认不启用。
OPERATIONS_ALERT_EMAIL=
OPERATIONS_TEST_EMAIL=
